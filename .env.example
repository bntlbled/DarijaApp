# Required: Claude does the transliteration, word tagging, translation and dialect call.
ANTHROPIC_API_KEY=
# Speech recognition: set at least one.
ELEVENLABS_API_KEY=
OPENAI_API_KEY=
# Optional overrides
# DARIJA_ASR=elevenlabs          # elevenlabs | openai | local
# DARIJA_MODEL=claude-opus-5-5
# DARIJA_EFFORT=medium           # low is cheaper/faster, high for noisy audio
# ELEVENLABS_MODEL=scribe_v1
# ELEVENLABS_LANGUAGE=ara        # empty = auto-detect
# OPENAI_ASR_MODEL=whisper-1
# LOCAL_WHISPER_MODEL=large-v3   # or a CTranslate2-converted Darija fine-tune
# Instagram (optional): your own professional account's reels via the official API.
# INSTAGRAM_ACCESS_TOKEN=        # Business Login for Instagram token, instagram_business_basic permission
# INSTAGRAM_API_VERSION=v25.0
